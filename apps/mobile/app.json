{
  "expo": {
    "name": "Field Atlas",
    "slug": "field-atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldatlas",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.fieldatlas.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1F16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "uk.co.fieldatlas.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1F16"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Field Atlas to attach photos to posts and peak logs."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "mapTilerKey": "",
      "eas": {
        "projectId": "field-atlas-mobile"
      }
    }
  }
}
