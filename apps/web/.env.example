VITE_MAPTILER_KEY=your_browser_key

# Dev: use /api so Vite proxies to the API and session cookies stay on this origin.
# Production: usually /api (same origin via IIS).
VITE_API_URL=/api

# Optional store links for the mobile web gate (leave empty = Coming soon).
# VITE_APP_STORE_URL=https://apps.apple.com/...
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/...

# Optional: secret ops panel path (must match ADMIN_PATH on the API).
# VITE_OPS_PATH=ridge-ops-7f3k9q
