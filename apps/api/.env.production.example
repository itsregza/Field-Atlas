# Production example for Windows server (copy to apps/api/.env on the server)
PORT=8787
HOST=127.0.0.1
ENVIRONMENT=production
WEB_ORIGIN=https://fieldatlas.co.uk,https://www.fieldatlas.co.uk
DATABASE_URL=sqlite:///./data/fieldatlas.db

# Owner ops panel (secret path, not /admin). Leave empty to disable.
# Must match VITE_OPS_PATH in the web build.
ADMIN_PATH=ridge-ops-7f3k9q
ADMIN_EMAILS=you@example.com
