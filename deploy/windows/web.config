<?xml version="1.0" encoding="UTF-8"?>
<!--
  Same pattern as Pingster: IIS terminates HTTPS, then reverse-proxies
  everything to the local Python process on 8787.
  Put this web.config in the IIS site physical path (or copy from deploy/windows).
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="FieldAtlasToUvicorn" stopProcessing="true">
                    <match url="(.*)" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                    </serverVariables>
                    <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
